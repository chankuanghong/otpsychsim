# Copy this file to .env for local development.
# Never commit real API keys.

PORT=8792
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ADMIN_PASSWORD=optional_supervisor_password_here

# Optional. When set, students must enter this code before the app can spend
# ElevenLabs or Gemini credits through the backend.
SIMULATION_ACCESS_CODE=optional_student_access_code_here

# Gemini analysis for:
# - Therapeutic mode use with student verbatim
# - Interpersonal events with patient verbatim
# - Matching therapeutic modes to interpersonal events
# - Patient emotional state and progression stage
GEMINI_API_KEY=your_google_ai_studio_api_key_here
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash-lite
GEMINI_ANALYSIS_ENABLED=true
GEMINI_STAGE_FRAMEWORK=engagement_exploration_insight_action_consolidation
